{
  "name": "pi-tabs",
  "displayName": "Pi Tabs",
  "description": "Run the Pi coding agent TUI in VS Code editor tabs, with a sessions sidebar, searchable history and subagent tabs.",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1c2a",
    "theme": "dark"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pi",
    "ai",
    "agent",
    "coding agent",
    "terminal",
    "tui",
    "xterm"
  ],
  "homepage": "https://github.com/Enubia/pi-extensions/blob/main/apps/pi-tabs",
  "bugs": {
    "url": "https://github.com/Enubia/pi-extensions/issues"
  },
  "publisher": "Enubia",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:piTabs.sessions"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --sourcemap --outfile=dist/extension.js && esbuild src/webview.ts --bundle --format=iife --target=chrome120 --sourcemap --outfile=dist/webview.js",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && code --new-window --extensionDevelopmentPath=\"$PWD\" ../..",
    "package": "npm run build && vsce package --no-dependencies --baseContentUrl https://github.com/Enubia/pi-extensions/blob/main/apps/pi-tabs --baseImagesUrl https://github.com/Enubia/pi-extensions/raw/main/apps/pi-tabs -o pi-tabs.vsix",
    "install-extension": "npm run package && code --install-extension pi-tabs.vsix --force ${VSCODE_PROFILE:+--profile \"$VSCODE_PROFILE\"}",
    "publish": "npm run build && vsce publish --no-dependencies --baseContentUrl https://github.com/Enubia/pi-extensions/blob/main/apps/pi-tabs --baseImagesUrl https://github.com/Enubia/pi-extensions/raw/main/apps/pi-tabs"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piTabs",
          "title": "Pi Tabs",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "piTabs": [
        {
          "id": "piTabs.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "piTabs.newSession",
        "title": "Pi: New Session",
        "icon": "$(add)"
      },
      {
        "command": "piTabs.newSessionInFolder",
        "title": "Pi: New Session in Folder…",
        "icon": "$(folder-opened)"
      },
      {
        "command": "piTabs.newSessionHere",
        "title": "New Pi Session Here",
        "icon": "$(add)"
      },
      {
        "command": "piTabs.reveal",
        "title": "Show Pi Session"
      },
      {
        "command": "piTabs.search",
        "title": "Pi: Search Sessions",
        "icon": "$(search)"
      },
      {
        "command": "piTabs.searchHere",
        "title": "Search Sessions Here",
        "icon": "$(search)"
      },
      {
        "command": "piTabs.openSessionFile",
        "title": "Open Pi Session"
      }
    ],
    "keybindings": [
      {
        "command": "piTabs.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "piTabs.search",
          "when": "view == piTabs.sessions",
          "group": "navigation@0"
        },
        {
          "command": "piTabs.newSession",
          "when": "view == piTabs.sessions",
          "group": "navigation@1"
        },
        {
          "command": "piTabs.newSessionInFolder",
          "when": "view == piTabs.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "piTabs.newSessionHere",
          "when": "view == piTabs.sessions && viewItem == workspace",
          "group": "inline"
        },
        {
          "command": "piTabs.searchHere",
          "when": "view == piTabs.sessions && viewItem == workspace",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "piTabs.newSessionHere",
          "when": "false"
        },
        {
          "command": "piTabs.reveal",
          "when": "false"
        },
        {
          "command": "piTabs.searchHere",
          "when": "false"
        },
        {
          "command": "piTabs.openSessionFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Pi Tabs",
      "properties": {
        "piTabs.command": {
          "type": "string",
          "default": "pi",
          "description": "Command run through your login shell."
        },
        "piTabs.macOptionIsMeta": {
          "type": "boolean",
          "default": false
        },
        "piTabs.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Falls back to terminal.integrated.fontFamily, then editor.fontFamily."
        },
        "piTabs.fontSize": {
          "type": "number",
          "default": 0
        },
        "piTabs.renderer": {
          "type": "string",
          "enum": [
            "webgl",
            "dom"
          ],
          "default": "webgl"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-unicode11": "0.10.0-beta.301",
    "@xterm/addon-web-links": "0.13.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.304",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Enubia/pi-extensions.git",
    "directory": "apps/pi-tabs"
  }
}
